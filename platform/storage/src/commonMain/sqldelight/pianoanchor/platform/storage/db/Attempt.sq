-- Completed attempts (AttemptRepositoryPort). band is the Band enum's name; tempo_bpm is null for wait mode;
-- latency_offset_nanos is the piano's offset the run was judged with, null when played uncalibrated; hint_level is
-- the HintLevel enum's name the run started at and hint_shown (0 or 1) whether any hint showed; mode is the RunMode enum's name;
-- spot_first_bar and spot_last_bar are the bar range of a spot loop, both null for a full run.
CREATE TABLE attempt (
    id TEXT NOT NULL PRIMARY KEY,
    passage_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    started_at_ms INTEGER NOT NULL,
    duration_nanos INTEGER NOT NULL,
    step_count INTEGER NOT NULL,
    wrong_notes INTEGER NOT NULL,
    incomplete_chords INTEGER NOT NULL,
    accuracy REAL NOT NULL,
    band TEXT NOT NULL,
    tempo_bpm INTEGER,
    latency_offset_nanos INTEGER,
    hint_level TEXT NOT NULL DEFAULT 'FULL',
    hint_shown INTEGER NOT NULL DEFAULT 1,
    mode TEXT NOT NULL DEFAULT 'PRACTICE',
    spot_first_bar INTEGER,
    spot_last_bar INTEGER
);

CREATE INDEX attempt_passage_started ON attempt(passage_id, started_at_ms DESC);

-- Today's practice days read every attempt since a cutoff across passages (selectStartedSince).
CREATE INDEX attempt_started ON attempt(started_at_ms);

-- An attempt's match events in order (seq from 0). kind names the MatchEvent subtype; note is set for a wrong note,
-- missing (comma-separated note numbers) for an incomplete chord.
CREATE TABLE attempt_event (
    attempt_id TEXT NOT NULL REFERENCES attempt(id) ON DELETE CASCADE,
    seq INTEGER NOT NULL,
    kind TEXT NOT NULL,
    t_nanos INTEGER NOT NULL,
    step_index INTEGER NOT NULL,
    note INTEGER,
    missing TEXT,
    PRIMARY KEY (attempt_id, seq),
    CHECK ((kind = 'wrong_note') = (note IS NOT NULL)),
    CHECK ((kind = 'chord_incomplete') = (missing IS NOT NULL))
);

-- An attempt's played notes in order (seq from 0), times rebased as the Attempt documents.
CREATE TABLE attempt_note (
    attempt_id TEXT NOT NULL REFERENCES attempt(id) ON DELETE CASCADE,
    seq INTEGER NOT NULL,
    pitch INTEGER NOT NULL,
    velocity INTEGER NOT NULL,
    down_nanos INTEGER NOT NULL,
    up_nanos INTEGER NOT NULL,
    sounding_end_nanos INTEGER NOT NULL,
    PRIMARY KEY (attempt_id, seq)
);

insertAttempt:
INSERT INTO attempt(
    id, passage_id, device_id, started_at_ms, duration_nanos, step_count, wrong_notes, incomplete_chords, accuracy, band,
    tempo_bpm, latency_offset_nanos, hint_level, hint_shown, mode,
    spot_first_bar, spot_last_bar
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertNote:
INSERT INTO attempt_note(attempt_id, seq, pitch, velocity, down_nanos, up_nanos, sounding_end_nanos)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectNotes:
SELECT * FROM attempt_note WHERE attempt_id = ? ORDER BY seq;

selectCleanTempos:
SELECT DISTINCT tempo_bpm FROM attempt WHERE passage_id = ? AND band = 'CLEAN' AND tempo_bpm IS NOT NULL AND spot_first_bar IS NULL;

insertEvent:
INSERT INTO attempt_event(attempt_id, seq, kind, t_nanos, step_index, note, missing)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM attempt WHERE id = ?;

selectEvents:
SELECT * FROM attempt_event WHERE attempt_id = ? ORDER BY seq;

selectRecent:
SELECT * FROM attempt WHERE passage_id = ? AND spot_first_bar IS NULL ORDER BY started_at_ms DESC LIMIT ?;

countStartedBefore:
SELECT COUNT(*) FROM attempt WHERE passage_id = ? AND spot_first_bar IS NULL AND started_at_ms < ?;

selectLastStarted:
SELECT MAX(started_at_ms) FROM attempt WHERE passage_id = ?;

selectStartedSince:
SELECT started_at_ms FROM attempt WHERE started_at_ms >= ?;

countCleanWaitRuns:
SELECT COUNT(*) FROM attempt WHERE passage_id = ? AND band = 'CLEAN' AND tempo_bpm IS NULL AND spot_first_bar IS NULL;

-- The earliest start of a CLEAN wait-mode run that showed no hint (the run that passes a lesson's concept).
selectFirstCleanUnaidedWaitStart:
SELECT MIN(started_at_ms) FROM attempt
WHERE passage_id = ? AND band = 'CLEAN' AND tempo_bpm IS NULL AND spot_first_bar IS NULL AND hint_shown = 0;

-- Summaries of the attempts whose passage id starts with :prefix, as a range (:prefix <= id < :upper, :upper being the
-- prefix with its last character incremented) that the attempt_passage_started index serves. No LIKE: % and _ stay literal.
selectSummariesInPrefixRange:
SELECT id, passage_id, started_at_ms, band FROM attempt
WHERE passage_id >= :prefix AND passage_id < :upper
ORDER BY started_at_ms, id;

-- The same when no :upper exists (the prefix ends in a character that can't be incremented): a lower bound plus an exact check.
selectSummariesByPrefixFrom:
SELECT id, passage_id, started_at_ms, band FROM attempt
WHERE passage_id >= :prefix AND instr(passage_id, :prefix) = 1
ORDER BY started_at_ms, id;

-- A full run (no spot) that covered every step: its events end the passage. The first one of each passage is never
-- pruned (Day 1 vs today replays it); any future pruning must keep it. Served by attempt_passage_started and the
-- attempt_event key.
selectFirstFullRun:
SELECT * FROM attempt
WHERE passage_id = ? AND spot_first_bar IS NULL
  AND EXISTS (SELECT 1 FROM attempt_event e WHERE e.attempt_id = attempt.id AND e.kind = 'passage_complete')
ORDER BY started_at_ms ASC, id ASC
LIMIT 1;

selectLatestFullRun:
SELECT * FROM attempt
WHERE passage_id = ? AND spot_first_bar IS NULL
  AND EXISTS (SELECT 1 FROM attempt_event e WHERE e.attempt_id = attempt.id AND e.kind = 'passage_complete')
ORDER BY started_at_ms DESC, id DESC
LIMIT 1;

-- Start and duration of every attempt since a cutoff (minutes per day are summed per local day in code).
selectDurationsSince:
SELECT started_at_ms, duration_nanos FROM attempt WHERE started_at_ms >= ?;
