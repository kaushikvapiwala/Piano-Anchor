-- Pianos the app has seen (InstrumentRepositoryPort). The identity columns are all null when the piano did not answer
-- the Identity Request; manufacturer id and version are their bytes as lowercase hex, two digits per byte.
CREATE TABLE instrument (
    device_id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    mfr_id TEXT,
    family INTEGER,
    model INTEGER,
    version TEXT,
    first_seen_ms INTEGER NOT NULL,
    last_seen_ms INTEGER NOT NULL,
    CHECK ((mfr_id IS NULL) = (family IS NULL) AND (mfr_id IS NULL) = (model IS NULL)
        AND (mfr_id IS NULL) = (version IS NULL))
);

-- Replaces everything but first_seen_ms, which keeps the earlier of the stored and the given value.
upsert:
INSERT INTO instrument(device_id, name, mfr_id, family, model, version, first_seen_ms, last_seen_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(device_id) DO UPDATE SET
    name = excluded.name,
    mfr_id = excluded.mfr_id,
    family = excluded.family,
    model = excluded.model,
    version = excluded.version,
    first_seen_ms = min(instrument.first_seen_ms, excluded.first_seen_ms),
    last_seen_ms = excluded.last_seen_ms;

selectByDeviceId:
SELECT * FROM instrument WHERE device_id = ?;
