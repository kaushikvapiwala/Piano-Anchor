-- The learner's review log (source of truth) and the cached state per skill (LearnerRepositoryPort). Days are ISO
-- yyyy-mm-dd text, which sorts as dates do. rating is the Rating enum's name; learned is 0 or 1. No foreign key to
-- attempt: attempts may be pruned, reviews outlive them (but never the first full run of a passage: Day 1 vs today replays it). One review per skill per day, enforced by the key. unaided is
-- 0 or 1: reviews stored before hints faded are 1.
CREATE TABLE review (
    skill_id TEXT NOT NULL,
    day TEXT NOT NULL,
    rating TEXT NOT NULL,
    attempt_id TEXT NOT NULL,
    unaided INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (skill_id, day)
);

CREATE TABLE skill_state (
    skill_id TEXT NOT NULL PRIMARY KEY,
    stability REAL NOT NULL,
    difficulty REAL NOT NULL,
    introduced_day TEXT NOT NULL,
    last_review_day TEXT NOT NULL,
    due_day TEXT NOT NULL,
    clean_cold_checks INTEGER NOT NULL,
    learned INTEGER NOT NULL,
    recalled_cold_checks INTEGER NOT NULL DEFAULT 0,
    unaided_recalled_checks INTEGER NOT NULL DEFAULT 0
);

hasReview:
SELECT count(*) > 0 FROM review WHERE skill_id = ? AND day = ?;

insertReview:
INSERT INTO review(skill_id, day, rating, attempt_id, unaided) VALUES (?, ?, ?, ?, ?);

selectReviews:
SELECT skill_id, day, rating, attempt_id, unaided FROM review WHERE skill_id = ? ORDER BY day;

upsertState:
INSERT OR REPLACE INTO skill_state(
    skill_id, stability, difficulty, introduced_day, last_review_day, due_day, clean_cold_checks, recalled_cold_checks, unaided_recalled_checks, learned
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectStates:
SELECT skill_id, stability, difficulty, introduced_day, last_review_day, due_day, clean_cold_checks, recalled_cold_checks, unaided_recalled_checks, learned
FROM skill_state;

deleteStates:
DELETE FROM skill_state;
