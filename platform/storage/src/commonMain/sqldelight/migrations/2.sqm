-- Schema 2 to 3 (M1.5): a calibration table (each piano's latency offset), and attempts keep the offset they were
-- judged with (null = played uncalibrated, and every older attempt).
CREATE TABLE calibration (
    device_id TEXT NOT NULL PRIMARY KEY,
    latency_offset_nanos INTEGER NOT NULL
);

ALTER TABLE attempt ADD COLUMN latency_offset_nanos INTEGER;
