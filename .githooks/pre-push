#!/bin/sh
# Pre-push: run everything CI's build job runs, so pushes rarely fail in CI.
# Deleting remote branches pushes no code, so a push of only deletions skips the build.
set -eu
cd "$(git rev-parse --show-toplevel)"
# Claude Code cloud sessions skip the build: their commits already ran fastCheck, and CI runs ciBuild on every PR.
if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
  echo "pre-push: cloud session, skipping ciBuild (CI runs it on the PR)"
  exit 0
fi
only_deletions=0
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>; a deletion has an all-zero local sha.
while read -r _ local_sha _ _; do
  case $local_sha in
    *[!0]*) only_deletions=0; break ;;
    *) only_deletions=1 ;;
  esac
done
[ "$only_deletions" -eq 1 ] && exit 0
./gradlew --quiet ciBuild
