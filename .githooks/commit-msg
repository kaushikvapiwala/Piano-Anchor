#!/bin/sh
# Commit-msg: require a Developer Certificate of Origin sign-off matching the author (git commit -s), as CI does.
# Merge commits are exempt (CI skips them too). The Conventional Commit format is checked on the PR title,
# which becomes the squash commit on main.
set -eu
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi
author="$(git var GIT_AUTHOR_IDENT | sed 's/ [0-9]* [-+][0-9]*$//')"
if ! grep -Fqx "Signed-off-by: $author" "$1"; then
  echo "commit-msg: missing 'Signed-off-by: $author' (must match the commit author)." >&2
  echo "Use git commit -s, git revert -s or git cherry-pick -s." >&2
  exit 1
fi
