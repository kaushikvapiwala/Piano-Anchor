#!/bin/sh
# Pre-commit: block gitlinks, auto-format staged Kotlin files, then run the fast gate.
# Install once per clone: ./gradlew installGitHooks
set -eu
cd "$(git rev-parse --show-toplevel)"

scripts/check_no_gitlinks.sh

staged="$(git diff --cached --name-only --diff-filter=ACMR -- '*.kt' '*.kts')"
if [ -n "$staged" ]; then
  # Re-staging a partially staged file would commit its unstaged hunks too, so only check those.
  partial="$(git diff --name-only -- $staged)"
  if [ -n "$partial" ]; then
    echo "pre-commit: partially staged files; checking format only (run ./gradlew spotlessApply yourself)."
  else
    ./gradlew --quiet spotlessApply
    # shellcheck disable=SC2086 # file names are newline-separated repo paths without spaces
    git add -- $staged
  fi
fi

./gradlew --quiet fastCheck
